    "Only thumbnails created by picsee are deleted. Your images are untouched. Confirm before clearing; thumbnails are rebuilt while browsing.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Only thumbnails created by picsee are deleted. Your images are untouched. Confirm before clearing; thumbnails are rebuilt while browsing."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "只删除 picsee 生成的缩略图，不会动你的图片。清理前先确认；清理后浏览时重新生成。"}}}},
    "Privacy Note": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Privacy Note"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "隐私说明"}}}},
    "Show File Names": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Show File Names"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "显示文件名"}}}},
    "Show names below thumbnails": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Show names below thumbnails"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在缩略图下显示文件名"}}}},
    "Source Code": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Source Code"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "源代码"}}}},
    "These are the same preferences as the grid footer Display panel; changes will sync immediately.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "These are the same preferences as the grid footer Display panel; changes will sync immediately."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "与网格底栏“显示”面板是同一组设置，任一处修改立即同步。"}}}},
    "This deletes picsee thumbnails only. Your images are untouched.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This deletes picsee thumbnails only. Your images are untouched."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "只删除 picsee 生成的缩略图，不会动你的图片。"}}}},
    "Thumbnail Size": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Thumbnail Size"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "缩略图大小"}}}},
