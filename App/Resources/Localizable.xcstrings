    "When off, tools hide after inactivity. Move the pointer to an edge or press Tab to show them.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "When off, tools hide after inactivity. Move the pointer to an edge or press Tab to show them."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "关闭时工具在不操作后自动隐藏，鼠标移到边缘或按 Tab 唤回。"}}}},
    "picsee contacts GitHub only to check for updates and sends no system information.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "picsee contacts GitHub only to check for updates and sends no system information."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "picsee 只在检查更新时访问 GitHub，不发送系统信息。"}}}},
    "picsee is released under the MIT License.\nThird party: Sparkle (MIT) · Welcome sample images from Unsplash (Unsplash License).": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "picsee is released under the MIT License.\nThird party: Sparkle (MIT) · Welcome sample images from Unsplash (Unsplash License)."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "picsee 以 MIT 许可发布\n第三方：Sparkle（MIT）· 首次打开页样图来自 Unsplash（Unsplash License）"}}}},
