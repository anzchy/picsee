    "A macOS image viewer for files on your disk. picsee collects no data and uploads no images; the sandbox reads only folders you authorize.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "A macOS image viewer for files on your disk. picsee collects no data and uploads no images; the sandbox reads only folders you authorize."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "一个直接浏览磁盘上图片的 macOS 看图应用。picsee 不收集数据，不上传图片；沙盒开启，只读取你授权的文件夹。"}}}},
    "About": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "About"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "关于"}}}},
