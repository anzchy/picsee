# picsee command rules for Codex (execpolicy, Starlark).
#
# Codex port of the delegator-only actions in the herdr roster plan
# (docs/plans/20261021-herdr-roster-migration-plan.md) and AGENTS.md
# "危险命令先问". Codex runs no role-guard hook, so these prefix rules stand in.
#
# Loaded only when this project's .codex/ layer is trusted.
# Test: npm run rules:check (requires codex on PATH; not wired into CI).
#
# Limits: a rule matches the argv prefix only. `git -C <dir> push`, sudo/env
# wrappers, and bash -c scripts using $(...), redirection or variables slip past;
# execpolicy does not split shell commands.
# These rules are a backstop, not the boundary; AGENTS.md still binds.
#
# apply_patch/editor edits to *.entitlements or project.yml are NOT caught.
# AGENTS.md and audit D4 check entitlements; doctor sandbox verifies the signed app.
#
# Ad-hoc re-signing (codesign --force --sign - without entitlements) also drops
# the sandbox entitlement. Signing stays allowed for device scripts; doctor
# sandbox is the guard for the signed app.

# --- AGENTS.md: destructive commands ------------------------------------------

prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-r", "-R", "--recursive", "-Rf", "-fR"]],
    decision = "forbidden",
    justification = "AGENTS.md: recursive delete needs the user's confirmation. Ask the delegator, naming the exact path.",
    match = ["rm -rf src", "rm -r docs/old", "rm --recursive tmp"],
    not_match = ["rm -f a.txt", "rm a.txt"],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Roster: only the delegator pushes. Commit on your branch and hand the SHA to the delegator.",
    match = ["git push", "git push -f origin main", "git push origin p0-01/x"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "AGENTS.md: destroys uncommitted work. Use `git stash` and ask the delegator.",
    match = ["git reset --hard HEAD~1"],
    not_match = ["git reset --soft HEAD~1", "git reset HEAD A.swift"],
)

prefix_rule(
    pattern = ["git", ["checkout", "restore"], "."],
    decision = "forbidden",
    justification = "AGENTS.md: discards all local changes. Use `git stash`, or restore named paths only.",
    match = ["git checkout .", "git restore ."],
    not_match = ["git checkout Sources/A.swift", "git restore Sources/A.swift"],
)

prefix_rule(
    pattern = ["git", "clean", ["-f", "-fd", "-df", "-fdx", "-xdf", "-fx", "-xf", "-ffdx"]],
    decision = "forbidden",
    justification = "AGENTS.md: removes untracked files permanently. Ask the delegator.",
    match = ["git clean -f", "git clean -fd", "git clean -fdx"],
    not_match = ["git clean -n"],
)

prefix_rule(
    pattern = ["git", "branch", ["-D", "--delete", "-d"]],
    decision = "forbidden",
    justification = "branches are deleted by the delegator after landing.",
    match = ["git branch -D p0-01/x", "git branch -d p0-01/x"],
    not_match = ["git branch --show-current", "git branch"],
)

prefix_rule(
    pattern = ["git", "worktree", "remove"],
    decision = "forbidden",
    justification = "Roster: the delegator removes worktrees with the user's confirmation.",
    match = ["git worktree remove ../picsee-wt/x"],
    not_match = ["git worktree list"],
)

# --- Roster: implementor limits (role-guard.sh equivalents) -----------------

prefix_rule(
    pattern = ["git", "add", ["-A", "--all", ".", "-u", "--update"]],
    decision = "forbidden",
    justification = "Roster: stage only paths you can name (`git add <path>...`), never the user's dirty files.",
    match = ["git add -A", "git add .", "git add -u"],
    not_match = ["git add Sources/A.swift Tests/ATests.swift"],
)

prefix_rule(
    pattern = ["git", "commit", ["-a", "-am", "--all"]],
    decision = "forbidden",
    justification = "Roster: no blanket staging. Stage named paths, then `git commit -m`.",
    match = ["git commit -a -m x", "git commit -am x"],
    not_match = ["git commit -m 'feat(core): x'"],
)

prefix_rule(
    pattern = ["git", ["checkout", "switch"], ["main"]],
    decision = "forbidden",
    justification = "Roster: never work on main. Stay on your own branch in your worktree.",
    match = ["git checkout main", "git switch main"],
    not_match = ["git checkout -b p0-01/x", "git switch p0-01/x"],
)

prefix_rule(
    pattern = ["gh", ["release", "workflow"]],
    decision = "forbidden",
    justification = "Roster: releases and workflow dispatch belong to the delegator.",
    match = ["gh release create v1", "gh workflow run release.yml"],
)

prefix_rule(
    pattern = ["gh", "pr", ["merge", "create", "close"]],
    decision = "forbidden",
    justification = "Roster: the delegator opens, merges and closes PRs.",
    match = ["gh pr merge 12", "gh pr create"],
    not_match = ["gh pr view 12", "gh pr diff 12"],
)

# --- AGENTS.md: sandbox, signing and privacy grants ---

prefix_rule(
    pattern = [["tccutil", "/usr/bin/tccutil"], "reset"],
    decision = "forbidden",
    justification = "AGENTS.md and migration plan A3: preserve privacy grants used by device acceptance. Ask the delegator, naming the service, bundle ID and acceptance state at risk; use read-only inspection instead.",
    match = ["/usr/bin/tccutil reset All", "tccutil reset All", "tccutil reset All io.github.anzchy.picsee", "tccutil reset SystemPolicyAllFiles"],
    not_match = ["tccutil --help"],
)

# Flags before --remove-signature (e.g. -f/--force/-v/--verbose) are NOT caught.
# This rule covers only the immediate operation prefix; AGENTS.md still binds.
prefix_rule(
    pattern = [["codesign", "/usr/bin/codesign"], "--remove-signature"],
    decision = "forbidden",
    justification = "AGENTS.md and migration plan A3: preserve the signature and sandbox entitlements. Ask the delegator, naming the app and signing problem; inspect with codesign -d or --verify instead.",
    match = ["codesign --remove-signature Picsee.app", "/usr/bin/codesign --remove-signature Picsee.app"],
    not_match = ["codesign -d --entitlements :- Picsee.app", "codesign --verify --deep --strict Picsee.app", "codesign --force --sign 'Apple Development' --entitlements Picsee.entitlements Picsee.app"],
)

# PlistBuddy's -c operation is a single literal argv token, not a parsed command.
# Cover Delete and Set/Add bool with false/true/0/1/NO/YES, with/without a root
# colon. Other whitespace, quoting, values, option orders and chained -c commands
# are NOT generalized by this list; AGENTS.md and the audit remain mandatory.
prefix_rule(
    pattern = [["PlistBuddy", "/usr/libexec/PlistBuddy"], "-c", [
        "Delete com.apple.security.app-sandbox",
        "Set com.apple.security.app-sandbox false",
        "Add com.apple.security.app-sandbox bool false",
        "Set com.apple.security.app-sandbox true",
        "Add com.apple.security.app-sandbox bool true",
        "Set com.apple.security.app-sandbox 0",
        "Add com.apple.security.app-sandbox bool 0",
        "Set com.apple.security.app-sandbox 1",
        "Add com.apple.security.app-sandbox bool 1",
        "Set com.apple.security.app-sandbox NO",
        "Add com.apple.security.app-sandbox bool NO",
        "Set com.apple.security.app-sandbox YES",
        "Add com.apple.security.app-sandbox bool YES",
        "Delete :com.apple.security.app-sandbox",
        "Set :com.apple.security.app-sandbox false",
        "Add :com.apple.security.app-sandbox bool false",
        "Set :com.apple.security.app-sandbox true",
        "Add :com.apple.security.app-sandbox bool true",
        "Set :com.apple.security.app-sandbox 0",
        "Add :com.apple.security.app-sandbox bool 0",
        "Set :com.apple.security.app-sandbox 1",
        "Add :com.apple.security.app-sandbox bool 1",
        "Set :com.apple.security.app-sandbox NO",
        "Add :com.apple.security.app-sandbox bool NO",
        "Set :com.apple.security.app-sandbox YES",
        "Add :com.apple.security.app-sandbox bool YES",
    ]],
    decision = "forbidden",
    justification = "AGENTS.md sandbox stays on; migration plan A3: do not mutate the App Sandbox key. Ask the delegator, naming the entitlement file, exact operation and sandbox conflict; use Print and record an ADR instead.",
    match = ["PlistBuddy -c 'Set :com.apple.security.app-sandbox false' Picsee.entitlements", "/usr/libexec/PlistBuddy -c 'Delete :com.apple.security.app-sandbox' Picsee.entitlements", "PlistBuddy -c 'Add com.apple.security.app-sandbox bool NO' Picsee.entitlements"],
    not_match = ["PlistBuddy -c Print Picsee.entitlements", "/usr/libexec/PlistBuddy -c Print Picsee.entitlements", "/usr/libexec/PlistBuddy -c 'Print :com.apple.security.app-sandbox' Picsee.entitlements", "/usr/libexec/PlistBuddy -c 'Set :unrelated.key false' Picsee.entitlements"],
)

# plutil uses dot-separated keypaths: backslash-dot addresses a literal dot.
# Both spellings are banned; options before the operation (e.g. -s) are NOT caught.
prefix_rule(
    pattern = [["plutil", "/usr/bin/plutil"], ["-replace", "-remove", "-insert"], ["com.apple.security.app-sandbox", "com\\.apple\\.security\\.app-sandbox"]],
    decision = "forbidden",
    justification = "AGENTS.md sandbox stays on; migration plan A3: do not replace, remove or insert the App Sandbox key. Ask the delegator, naming the entitlement file, exact operation and sandbox conflict; use plutil -p and record an ADR instead.",
    match = ["plutil -replace com.apple.security.app-sandbox -bool NO Picsee.entitlements", "/usr/bin/plutil -remove com.apple.security.app-sandbox Picsee.entitlements", "plutil -insert com.apple.security.app-sandbox -bool YES Picsee.entitlements", "plutil -replace 'com\\.apple\\.security\\.app-sandbox' -bool NO Picsee.entitlements", "plutil -remove 'com\\.apple\\.security\\.app-sandbox' Picsee.entitlements", "plutil -insert 'com\\.apple\\.security\\.app-sandbox' -bool NO Picsee.entitlements"],
    not_match = ["plutil -p Picsee.entitlements", "/usr/bin/plutil -p Picsee.entitlements", "plutil -replace unrelated.key -bool NO Picsee.entitlements"],
)
