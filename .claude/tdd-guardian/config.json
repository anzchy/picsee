{
  "schemaVersion": 2,
  "enabled": true,
  "enforceOnTaskCompleted": false,
  "blockCommitWithoutFreshGate": false,
  "staleGateAction": "deny",
  "gateFreshnessMinutes": 120,
  "smartStaleness": true,
  "bypassEnv": "TDD_GUARD_BYPASS",
  "preflightCommand": "",
  "lanes": [
    {
      "name": "unit",
      "description": "MadoKit package tests (Swift Testing) via SwiftPM; in-process, no external services. Same command as the CI 'Swift Testing' step, plus coverage.",
      "command": "swift test --package-path Packages/MadoKit --enable-code-coverage",
      "coverageReportCommand": "sh scripts/tdd/swift-lcov.sh",
      "gateOn": [
        "taskCompleted",
        "commit"
      ],
      "coverage": "include",
      "coverageSummaryPath": "coverage/lcov.info",
      "probeCommand": "scripts/heavy-lock.sh swift test --package-path Packages/MadoKit --list-tests",
      "timeoutMs": 600000
    },
    {
      "name": "integration",
      "description": "Real filesystem/security-scope adapter and Session/admission/ImageIO regression paths for File Grants; native sandbox delivery remains signed device smoke.",
      "command": "node scripts/tdd/swift-lane.mjs 'issue73SystemScopeReadabilityReflectsRealFiles|issue73ReadableDropSessionOpensEmptyThenReplacesAndRejectsZIP|accessSystemAdapterCreatesAndResolvesRealBookmark|issue140SystemFileBookmarkFollowsSameVolumeRename'",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "probeCommand": "scripts/heavy-lock.sh swift test --package-path Packages/MadoKit --list-tests --filter 'issue73SystemScopeReadabilityReflectsRealFiles|issue73ReadableDropSessionOpensEmptyThenReplacesAndRejectsZIP|accessSystemAdapterCreatesAndResolvesRealBookmark|issue140SystemFileBookmarkFollowsSameVolumeRename'",
      "timeoutMs": 600000
    },
    {
      "name": "swift-red",
      "description": "Selected SwiftPM test for RED receipts. Set PICSEE_SWIFT_FILTER on both record and verify; --files only selects fingerprints.",
      "command": "node scripts/tdd/swift-lane.mjs",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "probeCommand": "scripts/heavy-lock.sh swift test --package-path Packages/MadoKit --list-tests",
      "timeoutMs": 600000
    },
    {
      "name": "app-red",
      "description": "Compiled MadoAppTests. Optional PICSEE_APP_FILTER selects runtime test IDs; keep the same filter for record and verify (env is not stored in receipts). Set PICSEE_APP_LANE_NO_RETRY=1 for RED. Build-for-testing before RED record.",
      "setupCommand": "scripts/heavy-lock.sh xcodebuild build-for-testing -scheme Mado -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO -derivedDataPath .build/dd-ci -only-testing:MadoAppTests",
      "command": "node scripts/tdd/app-lane.mjs",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "probeCommand": "scripts/heavy-lock.sh xcodebuild -list -project Mado.xcodeproj",
      "timeoutMs": 2400000
    },
    {
      "name": "release-node",
      "description": "Release tooling node tests (signed-app entitlement checker, #220). Pure parse/compare logic; no codesign.",
      "command": "node scripts/tdd/node-lane.mjs scripts/release/check-entitlements.test.mjs",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "probeCommand": "node --version",
      "timeoutMs": 120000
    },
    {
      "name": "name-check-node",
      "command": "node scripts/tdd/node-lane.mjs scripts/name-checks/identity-transition.test.mjs",
      "probeCommand": "node --version",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "timeoutMs": 120000
    },
    {
      "name": "module-name-node",
      "command": "node scripts/tdd/node-lane.mjs scripts/name-checks/module-name.test.mjs",
      "probeCommand": "node --version",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "timeoutMs": 120000
    }
  ],
  "coverageThresholds": {
    "lines": 100,
    "functions": 100,
    "branches": 0,
    "statements": 100
  },
  "coverageMode": "absolute",
  "requireMutation": false,
  "mutationCommand": "",
  "mutationGateOn": [
    "push"
  ]
}
