{
  "schemaVersion": 2,
  "enabled": true,
  "enforceOnTaskCompleted": false,
  "blockCommitWithoutFreshGate": false,
  "staleGateAction": "deny",
  "gateFreshnessMinutes": 120,
  "smartStaleness": true,
  "bypassEnv": "TDD_GUARD_BYPASS",
  "preflightCommand": "",
  "lanes": [
    {
      "name": "unit",
      "description": "PicseeKit package tests (Swift Testing) via SwiftPM; in-process, no external services. Same command as the CI 'Swift Testing' step, plus coverage.",
      "command": "swift test --package-path Packages/PicseeKit --enable-code-coverage",
      "coverageReportCommand": "sh scripts/tdd/swift-lcov.sh",
      "gateOn": [
        "taskCompleted",
        "commit"
      ],
      "coverage": "include",
      "coverageSummaryPath": "coverage/lcov.info",
      "probeCommand": "scripts/heavy-lock.sh swift test --package-path Packages/PicseeKit --list-tests",
      "timeoutMs": 600000
    },
    {
      "name": "integration",
      "description": "Real filesystem/security-scope adapter and Session/admission/ImageIO regression paths for File Grants; native sandbox delivery remains signed device smoke.",
      "command": "node scripts/tdd/swift-lane.mjs 'issue73SystemScopeReadabilityReflectsRealFiles|issue73ReadableDropSessionOpensEmptyThenReplacesAndRejectsZIP|accessSystemAdapterCreatesAndResolvesRealBookmark|issue140SystemFileBookmarkFollowsSameVolumeRename'",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "probeCommand": "scripts/heavy-lock.sh swift test --package-path Packages/PicseeKit --list-tests --filter 'issue73SystemScopeReadabilityReflectsRealFiles|issue73ReadableDropSessionOpensEmptyThenReplacesAndRejectsZIP|accessSystemAdapterCreatesAndResolvesRealBookmark|issue140SystemFileBookmarkFollowsSameVolumeRename'",
      "timeoutMs": 600000
    },
    {
      "name": "swift-red",
      "description": "Selected SwiftPM test for RED receipts. Set PICSEE_SWIFT_FILTER on both record and verify; --files only selects fingerprints.",
      "command": "node scripts/tdd/swift-lane.mjs",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "probeCommand": "scripts/heavy-lock.sh swift test --package-path Packages/PicseeKit --list-tests",
      "timeoutMs": 600000
    },
    {
      "name": "app-red",
      "description": "Compiled PicseeAppTests through installed NSApp main menu and real NSEvent key equivalent. Build-for-testing before RED record.",
      "setupCommand": "scripts/heavy-lock.sh xcodebuild build-for-testing -scheme Picsee -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO -derivedDataPath .build/dd-ci -only-testing:PicseeAppTests",
      "command": "node scripts/tdd/app-lane.mjs",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "probeCommand": "scripts/heavy-lock.sh xcodebuild -list -project Picsee.xcodeproj",
      "timeoutMs": 2400000
    }
  ],
  "coverageThresholds": {
    "lines": 100,
    "functions": 100,
    "branches": 0,
    "statements": 100
  },
  "coverageMode": "absolute",
  "requireMutation": false,
  "mutationCommand": "",
  "mutationGateOn": [
    "push"
  ]
}
